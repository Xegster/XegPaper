<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XegPaper">

        <activity
            android:name=".settings.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XegPaper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened from the system wallpaper picker's "Settings" affordance. -->
        <activity-alias
            android:name=".settings.WallpaperSettingsActivity"
            android:exported="true"
            android:label="@string/wallpaper_settings_label"
            android:targetActivity=".settings.MainActivity" />

        <service
            android:name=".wallpaper.XegPaperWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>
    </application>

</manifest>
